#!/bin/bash
# Cotor CLI wrapper script

export PATH="${PATH:+$PATH:}$HOME/.local/bin:$HOME/.opencode/bin:$HOME/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

# Get the real path of this script (follow symlinks)
SCRIPT_PATH="$(/usr/bin/python3 -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd "$(/usr/bin/dirname "$SCRIPT_PATH")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
GRADLE_JAVA_HELPER="$PROJECT_ROOT/shell/resolve-gradle-java.sh"

# Find JDK 17 for Gradle builds and JAR execution.
# The project targets JDK 17 (build.gradle.kts jvmToolchain(17)).
if [ -z "$JAVA_HOME" ] || ! "$JAVA_HOME/bin/java" -version 2>&1 | /usr/bin/grep -q '"17\.'; then
    for candidate in \
        "$HOME/Library/Java/JavaVirtualMachines/corretto-17"*/Contents/Home \
        "$HOME/Library/Java/JavaVirtualMachines/temurin-17"*/Contents/Home \
        "$HOME/Library/Java/JavaVirtualMachines/ms-17"*/Contents/Home \
        /Library/Java/JavaVirtualMachines/jdk-17*/Contents/Home \
        /Library/Java/JavaVirtualMachines/temurin-17*/Contents/Home \
        /Library/Java/JavaVirtualMachines/corretto-17*/Contents/Home \
        /Library/Java/JavaVirtualMachines/amazon-corretto-17*/Contents/Home; do
        if [ -x "$candidate/bin/java" ]; then
            export JAVA_HOME="$candidate"
            break
        fi
    done
fi

if [ -z "$JAVA_HOME" ]; then
    JDK17=$(/usr/libexec/java_home -v 17 2>/dev/null || true)
    if [ -n "$JDK17" ] && [ -x "$JDK17/bin/java" ]; then
        export JAVA_HOME="$JDK17"
    fi
fi

if ! command -v java &> /dev/null && [ -z "$JAVA_HOME" ]; then
    echo "Error: Java 17 is not installed or not in PATH"
    echo "Please install JDK 17: brew install --cask corretto@17"
    exit 1
fi

JAVA_CMD="${JAVA_HOME:+$JAVA_HOME/bin/}java"

# Determine project version from build.gradle.kts and fall back to the newest shaded jar.
APP_VERSION=$(/usr/bin/grep -E '^[[:space:]]*version[[:space:]]*=' "$PROJECT_ROOT/build.gradle.kts" | /usr/bin/head -n 1 | /usr/bin/cut -d '"' -f2 | /usr/bin/tr -d '\r')
[ -z "$APP_VERSION" ] && APP_VERSION="1.0.0"

# Path to the shaded JAR file (built via shadowJar)
JAR_PATH="$PROJECT_ROOT/build/libs/cotor-${APP_VERSION}-all.jar"
JAR_TOOL="${JAVA_HOME:+$JAVA_HOME/bin/}jar"
BUILD_LOCK_DIR="$PROJECT_ROOT/build/.cotor-cli-build.lock"
BUILD_LOCK_STALE_AFTER_SECONDS=30

release_build_lock() {
    if [ "${COTOR_CLI_BUILD_LOCK_HELD:-}" = "1" ]; then
        /bin/rm -rf "$BUILD_LOCK_DIR" >/dev/null 2>&1 || true
        COTOR_CLI_BUILD_LOCK_HELD=0
    fi
}

lock_age_seconds() {
    if [ ! -d "$BUILD_LOCK_DIR" ]; then
        echo 0
        return
    fi
    local modified
    local now
    modified=$(/usr/bin/stat -f %m "$BUILD_LOCK_DIR" 2>/dev/null || echo 0)
    now=$(/bin/date +%s)
    if [ "$modified" -gt 0 ] 2>/dev/null; then
        echo $((now - modified))
    else
        echo 0
    fi
}

recover_stale_build_lock_if_needed() {
    if [ ! -d "$BUILD_LOCK_DIR" ]; then
        return
    fi

    local pid
    pid=$(/bin/cat "$BUILD_LOCK_DIR/pid" 2>/dev/null || true)
    if [ -n "$pid" ]; then
        if kill -0 "$pid" 2>/dev/null; then
            return
        fi
        echo "Recovering stale cotor CLI build lock from dead pid $pid."
    else
        local age
        age=$(lock_age_seconds)
        if [ "$age" -lt "$BUILD_LOCK_STALE_AFTER_SECONDS" ] 2>/dev/null; then
            return
        fi
        echo "Recovering stale cotor CLI build lock with no pid after ${age}s."
    fi

    local stale_dir
    stale_dir="${BUILD_LOCK_DIR}.stale.$$"
    if /bin/mv "$BUILD_LOCK_DIR" "$stale_dir" 2>/dev/null; then
        /bin/rm -rf "$stale_dir" >/dev/null 2>&1 || true
    fi
}

acquire_build_lock() {
    /bin/mkdir -p "$PROJECT_ROOT/build" || exit 1
    local waited=0
    while ! /bin/mkdir "$BUILD_LOCK_DIR" 2>/dev/null; do
        recover_stale_build_lock_if_needed
        if [ "$waited" -eq 0 ]; then
            echo "Waiting for another cotor CLI build to finish..."
        fi
        if [ "$waited" -ge 300 ]; then
            echo "Error: timed out waiting for cotor CLI build lock at $BUILD_LOCK_DIR"
            exit 1
        fi
        sleep 1
        waited=$((waited + 1))
    done
    COTOR_CLI_BUILD_LOCK_HELD=1
    echo "$$" > "$BUILD_LOCK_DIR/pid" 2>/dev/null || true
    trap release_build_lock TERM INT HUP EXIT
}

jar_is_valid() {
    [ -f "$1" ] && "$JAR_TOOL" tf "$1" >/dev/null 2>&1
}

build_cli_jar() {
    echo "Building cotor CLI (./gradlew shadowJar)..."
    if [ -x "$PROJECT_ROOT/gradlew" ]; then
        if [ -f "$GRADLE_JAVA_HELPER" ]; then
            # shellcheck source=/dev/null
            source "$GRADLE_JAVA_HELPER"
            configure_gradle_java || exit 1
            JAVA_CMD="${JAVA_HOME:+$JAVA_HOME/bin/}java"
            JAR_TOOL="${JAVA_HOME:+$JAVA_HOME/bin/}jar"
        fi
        (cd "$PROJECT_ROOT" && ./gradlew shadowJar) || exit 1
    else
        echo "Error: gradlew not found in $PROJECT_ROOT"
        exit 1
    fi
}

select_latest_valid_jar() {
    LATEST_JAR=""
    local newest_mtime=0
    local libs_dir="$PROJECT_ROOT/build/libs"
    [ -d "$libs_dir" ] || return 1
    while IFS= read -r -d '' candidate; do
        if jar_is_valid "$candidate"; then
            local candidate_mtime
            candidate_mtime=$(/usr/bin/stat -f %m "$candidate" 2>/dev/null || echo 0)
            if [ "$candidate_mtime" -ge "$newest_mtime" ] 2>/dev/null; then
                newest_mtime="$candidate_mtime"
                LATEST_JAR="$candidate"
            fi
        fi
    done < <(/usr/bin/find "$libs_dir" -type f -name 'cotor-*-all.jar' -print0 2>/dev/null)
    if [ -n "$LATEST_JAR" ] && [ -f "$LATEST_JAR" ]; then
        JAR_PATH="$LATEST_JAR"
        return 0
    fi
    return 1
}

select_existing_cli_jar() {
    if jar_is_valid "$JAR_PATH"; then
        return 0
    fi
    if select_latest_valid_jar; then
        if [ "$JAR_PATH" != "$PROJECT_ROOT/build/libs/cotor-${APP_VERSION}-all.jar" ]; then
            echo "Using latest valid cotor CLI jar: $JAR_PATH"
        fi
        return 0
    fi
    return 1
}

if ! select_existing_cli_jar; then
    acquire_build_lock

    if ! select_existing_cli_jar; then
        if [ -f "$JAR_PATH" ]; then
            echo "Existing cotor CLI jar is invalid; rebuilding..."
            /bin/rm -f "$JAR_PATH" || exit 1
        fi
        build_cli_jar
    fi

    if ! jar_is_valid "$JAR_PATH"; then
        if ! select_latest_valid_jar; then
            echo "Error: unable to locate a valid shaded CLI jar under $PROJECT_ROOT/build/libs"
            exit 1
        fi
    fi

    release_build_lock
    trap - TERM INT HUP EXIT
fi

if [ "${1:-}" = "app-server" ]; then
    APP_HOME="${COTOR_APP_HOME:-${HOME}/Library/Application Support/CotorDesktop}"
    RUNTIME_BACKEND_DIR="$APP_HOME/runtime/backend"
    RUNTIME_JAR="$RUNTIME_BACKEND_DIR/cotor-app-server-$$.jar"
    /bin/mkdir -p "$RUNTIME_BACKEND_DIR" || exit 1
    /bin/cp "$JAR_PATH" "$RUNTIME_JAR" || exit 1
    JAVA_CHILD_PID=""
    cleanup_app_server() {
        if [ -n "$JAVA_CHILD_PID" ]; then
            kill -TERM "$JAVA_CHILD_PID" 2>/dev/null || true
            local waited=0
            while kill -0 "$JAVA_CHILD_PID" 2>/dev/null && [ "$waited" -lt 10 ]; do
                sleep 1
                waited=$((waited + 1))
            done
            kill -KILL "$JAVA_CHILD_PID" 2>/dev/null || true
        fi
        /bin/rm -f "$RUNTIME_JAR" >/dev/null 2>&1 || true
    }
    trap cleanup_app_server TERM INT HUP EXIT
    export COTOR_PROJECT_ROOT="$PROJECT_ROOT"
    "$JAVA_CMD" -jar "$RUNTIME_JAR" "$@" &
    JAVA_CHILD_PID=$!
    wait "$JAVA_CHILD_PID"
    exit $?
fi

uses_source_lifecycle_command() {
    case "${1:-}" in
        install|update|upgrade|delete)
            return 0
            ;;
        *)
            return 1
            ;;
    esac
}

if uses_source_lifecycle_command "$@"; then
    TMPDIR_VALUE="${TMPDIR:-/tmp}"
    CLI_RUNTIME_DIR="$(/usr/bin/mktemp -d "${TMPDIR_VALUE%/}/cotor-cli-runtime.XXXXXX")" || exit 1
    CLI_RUNTIME_JAR="$CLI_RUNTIME_DIR/cotor-cli.jar"
    /bin/cp "$JAR_PATH" "$CLI_RUNTIME_JAR" || {
        /bin/rm -rf "$CLI_RUNTIME_DIR" >/dev/null 2>&1 || true
        exit 1
    }
    cleanup_cli_runtime_jar() {
        /bin/rm -rf "$CLI_RUNTIME_DIR" >/dev/null 2>&1 || true
    }
    trap cleanup_cli_runtime_jar EXIT TERM INT HUP
    JAR_PATH="$CLI_RUNTIME_JAR"
fi

# Run the JAR with all arguments passed to this script
export COTOR_PROJECT_ROOT="$PROJECT_ROOT"
"$JAVA_CMD" -jar "$JAR_PATH" "$@"
